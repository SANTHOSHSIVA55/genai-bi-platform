# ?????? Database ????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????
# PostgreSQL for production. Omit (or use a sqlite:/// path) for local development.
DATABASE_URL=postgresql+psycopg2://genai:CHANGE_ME@db:5432/genai_bi

# ?????? Security ????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????
# REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=60
EMAIL_VERIFY_EXPIRE_HOURS=24

# ?????? CORS ????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# ?????? AI provider (NVIDIA NIM, OpenAI-compatible) ???????????????????????????????????????
# Leave NVIDIA_API_KEY empty to use the deterministic local NL->SQL engine.
NVIDIA_API_KEY=
NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash-0731
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
AI_TIMEOUT_SECONDS=60
AI_MAX_TOKENS=2048

# ?????? Email (optional) ????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????
# When SMTP_HOST is unset, emails are written to the application log (dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=GenAI BI Platform <noreply@example.com>

# ?????? Logging ???????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????
LOG_LEVEL=INFO
